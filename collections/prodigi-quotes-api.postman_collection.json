  "info": {
    "_postman_id": "f275159f-549d-4abc-8ee8-4e5cada605f8",
    "name": "Prodigi Print Orders Quotes API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "The Prodigi Print API (v4.0) is a RESTful, JSON-based API for global print-on-demand fulfillment. It lets merchants create and manage print orders, request real-time quotes for pricing and shipping, and query the product catalogue by SKU. Orders progress through Prodigi's fulfillment stages, with per-order callbacks pushing status and shipment updates to a merchant-supplied callback URL.\n\nContact Support:\n Name: Prodigi Support\n Email: hi@prodigi.com",
      "type": "text/plain"
    }
  }
